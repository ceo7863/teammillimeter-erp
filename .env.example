VITE_USE_API=true
VITE_API_BASE=/api

# Server (.env in project root — loaded at startup by server/loadEnv.mjs)
PORT=8080
JWT_SECRET=change-this-secret-before-production
DATABASE_PATH=./data/erp.sqlite
PDF_ARCHIVE_DIR=./data/pdf-archives
CLIENT_CONTRACTS_DIR=./data/client-contracts

# IBK 기업뱅킹 거래내역 엑셀 자동 가져오기 (Windows 예: C:\Users\User\Downloads)
# IBK_BANK_IMPORT_DIR=
# BANK_SYNC_INTERVAL_MS=180000

# IBK / 금융결제원 오픈뱅킹 (테스트: testapi.openbanking.or.kr)
# OPEN_BANKING_ENABLED=true
# OPEN_BANKING_BASE_URL=https://testapi.openbanking.or.kr
# OPEN_BANKING_CLIENT_ID=
# OPEN_BANKING_CLIENT_SECRET=
# OPEN_BANKING_ORG_CODE=123456789
# OPEN_BANKING_REDIRECT_URI=http://localhost:8080/api/open-banking/oauth/callback
# OPEN_BANKING_SCOPE=login inquiry
# OPEN_BANKING_SYNC_DAYS=7
# OPEN_BANKING_FINTECH_USE_NUM=
# OPEN_BANKING_ACCESS_TOKEN=
# OPEN_BANKING_REFRESH_TOKEN=
# OPEN_BANKING_ACCOUNT_MASK=

# 바로빌 전자세금계산서 (테스트: testws.baroservice.com)
# BAROBILL_TEST=true
# BAROBILL_CERT_KEY=          # 바로빌 개발자센터에서 발급한 36자리 UUID 인증키
# BAROBILL_CORP_NUM=          # 사업자등록번호 10자리 (하이픈 없음, 예: 1234567890)
# BAROBILL_USER_ID=           # 바로빌 회원 아이디 (세금계산서 발행·조회 시 필요, 연결 테스트에는 CORP_NUM만 필요)
# BAROBILL_USER_PWD=          # 바로빌 로그인 비밀번호 (요금충전 URL 등 GetBaroBillURL 호출 시 필요)
# BAROBILL_CEO_NAME=          # 공급자(자사) 대표자명 — 정발행 API 필수 (미설정 시 발행 실패 가능)
# BAROBILL_CONTACT_EMAIL=     # 공급자 담당자 이메일 — 정발행 API 필수 (미설정 시 발행 실패 가능)
# BAROBILL_BIZ_TYPE=          # 공급자 업태 (미설정 시 회사정보 또는 건설업)
# BAROBILL_BIZ_CLASS=         # 공급자 업종 (미설정 시 회사정보 또는 가구시공)

# 바로빌 계좌거래내역조회 (BANKACCOUNT.asmx — IBK 빠른조회/간편조회 + 바로빌 서비스 신청 필요)
# BAROBILL_BANK_ACCOUNT_NUM=969-046529-04-015
# BAROBILL_BANK_SYNC_DAYS=7
# BAROBILL_BANK_SYNC_ENABLED=true

# 카카오 알림톡 — 솔라피(SOLAPI) 기본
# ALIMTALK_ENABLED=true
# ALIMTALK_SCHEDULER_ENABLED=true
# ALIMTALK_PROVIDER=solapi
# ALIMTALK_API_KEY=              # 솔라피 콘솔 → API Key
# ALIMTALK_API_SECRET=           # 솔라피 콘솔 → API Secret
# ALIMTALK_SENDER_KEY=           # 카카오 채널 pfId (KA01PF...)
# ALIMTALK_DAILY_REPORT_TEMPLATE= # 일일보고 템플릿 ID (KA01TP...)
# ALIMTALK_COMMENT_TEMPLATE=     # 코멘트 알림 템플릿 ID
# ALIMTALK_CONTRACT_TEMPLATE=    # 거래처 계약 서명 알림 템플릿 ID (#{client}, #{title}, #{url})
# ALIMTALK_SMS_FROM=             # (선택) 알림톡 실패 시 SMS 대체발송 번호
# ERP_PUBLIC_URL=https://erp.teammillimeter.com
#
# SC(office) 일정 → ERP 현장접수 캘린더 동기화 (read-only PostgreSQL)
# SC_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# 또는 DB URL 대신 SC HTTP export API:
# SC_API_BASE_URL=https://sc.teammillimeter.com
# SC_SYNC_SECRET=            # SC Vercel env ERP_SYNC_SECRET 과 동일
# SC_SCHEDULE_SYNC_ENABLED=true
# SC_SCHEDULE_SYNC_INTERVAL_MS=900000
# SC_SCHEDULE_SYNC_MONTHS=4
